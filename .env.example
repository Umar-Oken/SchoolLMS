# Copy to .env and set environment-specific values. Never commit the real .env file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Use a locally installed PostgreSQL server or set DB_HOST/DB_PORT for an existing database.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=school_lms
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
