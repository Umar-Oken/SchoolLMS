# Copy to .env and set environment-specific values. Never commit the real .env file.
DJANGO_DEBUG=true
RESOURCE_URL_ALLOWED_HOSTS=youtube.com,youtu.be,vimeo.com
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Use a locally installed PostgreSQL server or set DB_HOST/DB_PORT for an existing database.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=school_lms
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Use independent Redis logical databases for broker and short-lived task results.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Production scanner. fake is permitted only for development/tests.
ANTIVIRUS_SCANNER_BACKEND=clamav
ANTIVIRUS_CLAMAV_HOST=127.0.0.1
ANTIVIRUS_CLAMAV_PORT=3310
ANTIVIRUS_SCAN_TIMEOUT=15
