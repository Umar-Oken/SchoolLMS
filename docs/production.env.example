# Ushbu faylni production process manager secret store'iga moslab ko'chiring.
# Haqiqiy secret yoki parolni repositoryga yozmang.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_ALLOWED_HOSTS=api.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.edu

DB_ENGINE=django.db.backends.postgresql
DB_NAME=school_lms
DB_USER=schoollms
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Broker va cache production'da bitta Redis origin bo'lmasin.
CELERY_BROKER_URL=redis://redis-broker.internal:6379/0
CELERY_RESULT_BACKEND=redis://redis-results.internal:6379/0
TIMETABLE_CACHE_URL=redis://redis-cache.internal:6379/0
ABUSE_THROTTLE_CACHE_URL=redis://redis-cache.internal:6379/1

DJANGO_DEFAULT_MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true

# P081-A Nginx/TLS sozlangandan keyin true/katta son bilan yoqing.
# TLS release uchun: true, true, 31536000.
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# Gunicorn faqat loopback'da tinglaydi; public TLS reverse proxy P081-A scope'ida.
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# P081-B: default local. s3 uchun bucket private bo'lishi shart; credentiallar
# secret store orqali beriladi. Hech qaysi qiymat bucket/account yaratmaydi.
PRIVATE_STORAGE_BACKEND=local
PRIVATE_S3_BUCKET=replace-with-private-bucket
AWS_S3_ENDPOINT_URL=https://s3.example.edu
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
PRIVATE_S3_SIGNED_URL_TTL=60
